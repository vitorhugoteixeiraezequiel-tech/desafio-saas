# Chave da API do Google Gemini (gratuita): https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Segredo usado para assinar o cookie de sessão. Use qualquer texto longo e aleatório.
# Gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Opcional: modelos do Gemini tentados em ordem, separados por vírgula.
# Se um estiver sobrecarregado, o sistema passa para o próximo.
# GEMINI_MODELS=gemini-3-flash-preview,gemini-flash-latest,gemini-flash-lite-latest
