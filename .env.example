# Chave da API do Google Gemini (gratuita): https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Segredo usado para assinar o cookie de sessão. Use qualquer texto longo e aleatório.
# Gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Opcional: modelo do Gemini (padrão: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
# Opcional: modelo reserva, usado se o principal estiver sobrecarregado (padrão: gemini-flash-lite-latest)
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
